<% content_for :title, "Replay vs #{@match[:opponent].name}" %>

<div class="mb-6">
  <a href="<%= my_matches_path %>" class="text-indigo-400 hover:text-indigo-600 text-sm hover:underline">
    ← Volver a mis duelos
  </a>
</div>

<div class="mb-6 flex items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-indigo-700 mb-1">
      Replay: <%= current_group.name %> vs <%= @match[:opponent].name %>
    </h1>
    <p class="text-sm text-gray-500">
      Tu estrategia: <strong><%= current_group.strategy&.name %></strong> ·
      Rival: <strong><%= @match[:opponent_strategy]&.name %></strong> ·
      <%= @rounds.length %> rondas
    </p>
  </div>
  <%
    outcome_label = case @match[:outcome]
                    when :win  then "Victoria ✓"
                    when :draw then "Empate"
                    when :loss then "Derrota"
                    end
    outcome_style = case @match[:outcome]
                    when :win  then "bg-green-100 text-green-700"
                    when :draw then "bg-gray-100 text-gray-600"
                    when :loss then "bg-red-100 text-red-600"
                    end
  %>
  <span class="<%= outcome_style %> text-sm font-bold px-4 py-2 rounded-xl">
    <%= outcome_label %> · <%= @match[:my_score] %> – <%= @match[:their_score] %>
  </span>
</div>

<%# Stimulus replay controller — all round data is embedded as JSON %>
<div data-controller="match-replay"
     data-match-replay-rounds-value="<%= @rounds.to_json.html_safe %>"
     data-match-replay-my-side-value="<%= @match[:my_side] %>"
     data-match-replay-delay-value="300">

  <%# Scoreboard (updated by Stimulus) %>
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
      <p class="text-xs uppercase tracking-wide text-indigo-400 font-semibold mb-1">
        <%= current_group.name %> (tú)
      </p>
      <p class="text-4xl font-bold text-indigo-700" data-match-replay-target="myScore">0</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
      <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">
        <%= @match[:opponent].name %>
      </p>
      <p class="text-4xl font-bold text-gray-600" data-match-replay-target="theirScore">0</p>
    </div>
  </div>

  <%# Controls %>
  <div class="flex items-center justify-between mb-4">
    <p class="text-sm text-gray-500">
      Ronda <span data-match-replay-target="roundLabel">0</span> de <%= @rounds.length %>
    </p>
    <div class="flex gap-2">
      <button data-action="click->match-replay#skipAll"
              data-match-replay-target="skipButton"
              class="text-xs text-indigo-400 hover:text-indigo-600 border border-indigo-200 rounded px-3 py-1 transition">
        Ver todo de una vez →
      </button>
    </div>
  </div>

  <%# Round log (rows appended by Stimulus) %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 text-gray-400 text-xs uppercase tracking-wide border-b border-gray-100">
          <th class="px-4 py-3 text-left font-semibold">Ronda</th>
          <th class="px-4 py-3 text-center font-semibold"><%= current_group.name %></th>
          <th class="px-4 py-3 text-center font-semibold"><%= @match[:opponent].name %></th>
          <th class="px-4 py-3 text-right font-semibold">Pts ronda</th>
          <th class="px-4 py-3 text-right font-semibold">Acumulado</th>
        </tr>
      </thead>
      <tbody data-match-replay-target="roundsBody" class="divide-y divide-gray-50">
        <%# Rows injected by match_replay_controller.js %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-6 text-center">
  <%= link_to "← Mis duelos", my_matches_path,
      class: "text-indigo-400 hover:text-indigo-600 text-sm hover:underline" %>
</div>
