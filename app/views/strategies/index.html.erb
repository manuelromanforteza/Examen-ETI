<% content_for :title, "Elige tu estrategia — Torneo del Dilema" %>

<div class="mb-8">
  <h1 class="text-3xl font-bold text-indigo-700 mb-1">Elige tu estrategia</h1>
  <p class="text-gray-500 text-sm">
    Grupo: <strong class="text-gray-700"><%= current_group.name %></strong>
    <% if @current_selection %>
      &nbsp;·&nbsp; Estrategia actual:
      <span class="font-semibold text-indigo-600"><%= @current_selection.strategy.name %></span>
    <% end %>
  </p>
  <% unless @can_change %>
    <div class="mt-3 bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-2 text-sm">
      El torneo ya está en curso — no se puede cambiar la estrategia.
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
  <% @strategies.each do |strategy| %>
    <%
      selected = @current_selection&.strategy_id == strategy.id
      card_class = selected ?
        "relative bg-indigo-50 border-2 border-indigo-500 rounded-2xl p-6 shadow-md flex flex-col" :
        "relative bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition flex flex-col"
    %>
    <div class="<%= card_class %>">
      <% if selected %>
        <span class="absolute top-4 right-4 bg-indigo-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">
          ✓ Elegida
        </span>
      <% end %>

      <h2 class="text-lg font-bold text-gray-800 mb-2"><%= strategy.name %></h2>
      <p class="text-sm text-gray-600 mb-4 flex-1"><%= strategy.description %></p>

      <div class="space-y-2 mb-5">
        <div class="flex gap-2 items-start text-sm">
          <span class="text-green-500 font-bold mt-0.5">✚</span>
          <span class="text-gray-600"><%= strategy.pros %></span>
        </div>
        <div class="flex gap-2 items-start text-sm">
          <span class="text-red-400 font-bold mt-0.5">−</span>
          <span class="text-gray-600"><%= strategy.cons %></span>
        </div>
      </div>

      <% if @can_change && !selected %>
        <%= button_to "Elegir esta estrategia",
            pick_strategy_path(strategy),
            method: :post,
            class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg px-4 py-2 transition cursor-pointer" %>
      <% elsif @can_change && selected %>
        <%= link_to "Ver sala de espera →", waiting_path,
            class: "block text-center w-full bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-lg px-4 py-2 transition" %>
      <% end %>
    </div>
  <% end %>
</div>
