  [1m[36mStrategy Exists? (2.0ms)[0m  [1m[34mSELECT 1 AS one FROM "strategies" WHERE "strategies"."key" = 'always_cooperate' LIMIT 1 /*application='ExamenEti'*/[0m
  [1m[36mStrategy Create (0.3ms)[0m  [1m[32mINSERT INTO "strategies" ("cons", "created_at", "description", "key", "name", "pros", "updated_at") VALUES ('Completamente explotable: un rival que siempre traiciona obtiene 5 por ronda mientras esta estrategia acumula 0.', '2026-08-23 12:51:55.310918', 'Siempre coopera, sin importar lo que haga el rival ni el historial de la partida.', 'always_cooperate', 'Always Cooperate', 'Maximiza el puntaje conjunto si el rival también coopera siempre (ambos obtienen 3 por ronda).', '2026-08-23 12:51:55.310918') RETURNING "id" /*application='ExamenEti'*/[0m
  [1m[36mTRANSACTION (1.8ms)[0m  [1m[35mCOMMIT /*application='ExamenEti'*/[0m
