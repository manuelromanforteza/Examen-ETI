  [1m[36mStrategy Create (0.5ms)[0m  [1m[32mINSERT INTO "strategies" ("cons", "created_at", "description", "key", "name", "pros", "updated_at") VALUES ('Puede ser explotada por rivales que alternan cooperación y traición, ya que nunca acumula dos traiciones seguidas frente a ellos.', '2026-08-23 12:51:55.357155', 'Coopera siempre, excepto cuando el rival ha traicionado en las DOS rondas consecutivas inmediatamente anteriores. En ese caso traiciona una vez y vuelve a estar lista para cooperar.', 'tit_for_two_tats', 'Tit for Two Tats', 'Más «perdonadora» que Tit for Tat; evita ciclos de venganza por traiciones aisladas.', '2026-08-23 12:51:55.357155') RETURNING "id" /*application='ExamenEti'*/[0m
