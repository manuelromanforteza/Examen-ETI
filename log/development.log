  [1m[36mStrategy Create (0.6ms)[0m  [1m[32mINSERT INTO "strategies" ("cons", "created_at", "description", "key", "name", "pros", "updated_at") VALUES ('No tiene lógica estratégica real. En promedio rinde mal porque no explota el comportamiento cooperador ni castiga el traicionero.', '2026-08-23 12:51:55.399790', 'Coopera o traiciona con probabilidad 50/50 en cada ronda, de forma completamente aleatoria e independiente del historial.', 'random', 'Random', 'Completamente impredecible; ningún rival puede anticipar sus movimientos.', '2026-08-23 12:51:55.399790') RETURNING "id" /*application='ExamenEti'*/[0m
