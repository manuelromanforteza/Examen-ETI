  [1m[36mStrategy Create (0.7ms)[0m  [1m[32mINSERT INTO "strategies" ("cons", "created_at", "description", "key", "name", "pros", "updated_at") VALUES ('No perdona nunca. Un solo «accidente» desencadena defección mutua el resto del juego.', '2026-08-23 12:51:55.340292', 'Coopera en todas las rondas hasta que el rival traicione por primera vez. Desde ese momento, traiciona para siempre, sin excepción.', 'grudger', 'Grudger / Trigger', 'Disuade fuertemente la traición: el rival sabe que una sola defección arruina toda la partida.', '2026-08-23 12:51:55.340292') RETURNING "id" /*application='ExamenEti'*/[0m
  [1m[36mTRANSACTION (2.3ms)[0m  [1m[35mCOMMIT /*application='ExamenEti'*/[0m
