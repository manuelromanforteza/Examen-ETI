  [1m[36mStrategy Create (0.4ms)[0m  [1m[32mINSERT INTO "strategies" ("cons", "created_at", "description", "key", "name", "pros", "updated_at") VALUES ('Provoca represalia inmediata de estrategias reactivas. A largo plazo acumula castigos mutuos (1/1) en lugar de recompensas (3/3).', '2026-08-23 12:51:55.323871', 'Siempre traiciona, independientemente del historial o del movimiento del rival.', 'always_defect', 'Always Defect', 'Nunca «regala» puntos al rival. Gana cualquier duelo individual contra estrategias cooperadoras.', '2026-08-23 12:51:55.323871') RETURNING "id" /*application='ExamenEti'*/[0m
