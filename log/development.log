  [1m[36mStrategy Create (0.5ms)[0m  [1m[32mINSERT INTO "strategies" ("cons", "created_at", "description", "key", "name", "pros", "updated_at") VALUES ('La traición inicial provoca represalia innecesaria contra estrategias cooperadoras, perdiendo puntos en las primeras rondas.', '2026-08-23 12:51:55.372291', 'Igual que Tit for Tat, pero comienza traicionando en la primera ronda. A partir de la segunda, copia el último movimiento del rival.', 'suspicious_tit_for_tat', 'Suspicious Tit for Tat', '«Prueba» al rival desde el inicio; si el rival es cooperador, la estrategia se sincroniza rápidamente con él.', '2026-08-23 12:51:55.372291') RETURNING "id" /*application='ExamenEti'*/[0m
