  [1m[36mStrategy Create (0.5ms)[0m  [1m[32mINSERT INTO "strategies" ("cons", "created_at", "description", "key", "name", "pros", "updated_at") VALUES ('Su comportamiento es menos intuitivo de explicar y puede parecer errático frente a estrategias poco predecibles.', '2026-08-23 12:51:55.385786', 'Repite su jugada anterior si obtuvo un puntaje alto (3 ó 5 puntos). Cambia de jugada si obtuvo un puntaje bajo (0 ó 1 punto). Comienza cooperando.', 'pavlov', 'Pavlov (Win-Stay / Lose-Shift)', 'Se adapta dinámicamente. Tiene buen desempeño general y puede «corregir» a un rival que coopera pero duda.', '2026-08-23 12:51:55.385786') RETURNING "id" /*application='ExamenEti'*/[0m
